# Standardize line endings across Windows (GitHub Desktop) and Linux (GitHub Actions)
* text=auto eol=lf

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wasm binary
*.task binary
*.zip binary
